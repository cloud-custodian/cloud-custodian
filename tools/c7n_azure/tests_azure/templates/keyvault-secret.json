{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "variables": {
        "kvname": "[concat('cckvsecret', uniqueString(resourceGroup().id))]"
    },
    "resources": [
        {
            "type": "Microsoft.KeyVault/vaults",
            "name": "[variables('kvname')]",
            "apiVersion": "2023-07-01",
            "location": "southcentralus",
            "properties": {
                "sku": {
                    "family": "A",
                    "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "softDeleteRetentionInDays": 7
            }
        },
        {
            "type": "Microsoft.KeyVault/vaults/secrets",
            "name": "[concat(variables('kvname'), '/cctest-secret-noexp')]",
            "apiVersion": "2023-07-01",
            "properties": {
                "value": "c7n-test-value",
                "attributes": {
                    "enabled": true
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', variables('kvname'))]"
            ]
        },
        {
            "type": "Microsoft.KeyVault/vaults/secrets",
            "name": "[concat(variables('kvname'), '/cctest-secret-tags')]",
            "apiVersion": "2023-07-01",
            "tags": {
                "env": "prod",
                "owner": "team-a"
            },
            "properties": {
                "value": "c7n-test-value",
                "attributes": {
                    "enabled": true
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', variables('kvname'))]"
            ]
        }
    ]
}
