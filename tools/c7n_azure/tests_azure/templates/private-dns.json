{
   "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
   "contentVersion": "1.0.0.0",
   "parameters": {
      "privateDnsZoneName": {
         "type": "string",
         "defaultValue": "[concat('c7n-test.', uniqueString(resourceGroup().id), '.cloudcustodiantest.com')]"
      },
      "otherPrivateDnsZoneName": {
         "type": "string",
         "defaultValue": "[concat('c7n-other.', uniqueString(resourceGroup().id), '.cloudcustodiantest.com')]"
      },
      "wwwRecordName": {
         "type": "string",
         "defaultValue": "www"
      },
      "otherRecordName": {
         "type": "string",
         "defaultValue": "other"
      }
   },
   "resources": [
      {
         "type": "Microsoft.Network/privateDnsZones",
         "name": "[parameters('privateDnsZoneName')]",
         "apiVersion": "2018-09-01",
         "location": "global",
         "properties": {}
      },
      {
         "type": "Microsoft.Network/privateDnsZones",
         "name": "[parameters('otherPrivateDnsZoneName')]",
         "apiVersion": "2018-09-01",
         "location": "global",
         "properties": {}
      },
      {
         "type": "Microsoft.Network/privateDnsZones/A",
         "name": "[concat(parameters('privateDnsZoneName'), '/', parameters('wwwRecordName'))]",
         "apiVersion": "2018-09-01",
         "dependsOn": [
            "[parameters('privateDnsZoneName')]"
         ],
         "properties": {
            "ttl": 3600,
            "aRecords": [
               {
                  "ipv4Address": "1.2.3.4"
               },
               {
                  "ipv4Address": "1.2.3.5"
               }
            ]
         }
      },
      {
         "type": "Microsoft.Network/privateDnsZones/A",
         "name": "[concat(parameters('privateDnsZoneName'), '/', parameters('otherRecordName'))]",
         "apiVersion": "2018-09-01",
         "dependsOn": [
            "[parameters('privateDnsZoneName')]"
         ],
         "properties": {
            "ttl": 3600,
            "aRecords": [
               {
                  "ipv4Address": "1.2.3.6"
               }
            ]
         }
      }
   ]
}
