{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "variables": {
    "vms": [
      {"name": "cctestvmresize-vmsize", "size": "Standard_B1s"},
      {"name": "cctestvmresize-default", "size": "Standard_B1s"},
      {"name": "cctestvmresize-map-b1s", "size": "Standard_B1s"},
      {"name": "cctestvmresize-map-b1ms", "size": "Standard_B1ms"},
      {"name": "cctestvmresize-map-unmapped", "size": "Standard_B2s"}
    ],
    "virtualNetworkName": "cctestvmresize-vnet",
    "subnetName": "default",
    "subnetRef": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkName'), variables('subnetName'))]"
  },
  "resources": [
    {
      "apiVersion": "2023-04-01",
      "type": "Microsoft.Network/virtualNetworks",
      "name": "[variables('virtualNetworkName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": ["10.0.0.0/16"]
        },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "10.0.0.0/24"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "2023-04-01",
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[concat(variables('vms')[copyIndex()].name, '-nic')]",
      "location": "[resourceGroup().location]",
      "copy": {
        "name": "nicLoop",
        "count": "[length(variables('vms'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "2023-03-01",
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('vms')[copyIndex()].name]",
      "location": "[resourceGroup().location]",
      "copy": {
        "name": "vmLoop",
        "count": "[length(variables('vms'))]"
      },
      "tags": {
        "testtag": "testvalue"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vms')[copyIndex()].name, '-nic'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vms')[copyIndex()].size]"
        },
        "osProfile": {
          "computerName": "[variables('vms')[copyIndex()].name]",
          "adminUsername": "testuser",
          "adminPassword": "[concat(uniquestring(resourceGroup().id), '.!Aa1')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "deleteOption": "Delete",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vms')[copyIndex()].name, '-nic'))]"
            }
          ]
        }
      }
    }
  ]
}
