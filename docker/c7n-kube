# Dockerfiles are generated from tools/dev/dockerpkg.py
ARG UV_VERSION=0.7.12

# BuildKit does not expand variables in `COPY --from`, so pull uv in as a
# named stage and copy from that instead.
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ubuntu:24.04 AS build-env

SHELL ["/bin/bash", "-c"]

# pre-requisite distro deps, and build env setup
RUN apt-get --yes update
RUN apt-get --yes install --no-install-recommends build-essential     curl python3-venv python3-dev adduser
RUN adduser --disabled-login --gecos "" custodian
COPY --from=uv /uv /uvx /bin/
# the uv wheel cache is mounted into each `uv sync` below; it lives on a
# different filesystem than the venv, so hardlinks are not an option.
ENV UV_LINK_MODE=copy

WORKDIR /src
# Add core & aws packages
ARG providers="gcp azure kube openstack tencentcloud oci awscc"

# copy pyproject.tomls for all packages
ADD pyproject.toml uv.lock README.md /src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --inexact --no-install-workspace

# We include `pyproject.toml` and `uv.lock` first to allow
# cache of dependency installs.

ADD tools/c7n_gcp/pyproject.toml /src/tools/c7n_gcp/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "gcp" ]]; then    uv sync --package c7n_gcp --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_azure/pyproject.toml /src/tools/c7n_azure/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "azure" ]]; then    uv sync --package c7n_azure --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_kube/pyproject.toml /src/tools/c7n_kube/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "kube" ]]; then    uv sync --package c7n_kube --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_openstack/pyproject.toml /src/tools/c7n_openstack/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "openstack" ]]; then    uv sync --package c7n_openstack --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_tencentcloud/pyproject.toml /src/tools/c7n_tencentcloud/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "tencentcloud" ]]; then    uv sync --package c7n_tencentcloud --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_oci/pyproject.toml /src/tools/c7n_oci/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "oci" ]]; then    uv sync --package c7n_oci --frozen --inexact --no-install-workspace; fi

ADD tools/c7n_awscc/pyproject.toml /src/tools/c7n_awscc/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "awscc" ]]; then    uv sync --package c7n_awscc --frozen --inexact --no-install-workspace; fi


# copy packages
ADD c7n /src/c7n/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --inexact

# Now install the root of each provider

ADD tools/c7n_gcp /src/tools/c7n_gcp
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "gcp" ]]; then    uv sync --package c7n_gcp --frozen --inexact; fi

ADD tools/c7n_azure /src/tools/c7n_azure
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "azure" ]]; then    uv sync --package c7n_azure --frozen --inexact; fi

ADD tools/c7n_kube /src/tools/c7n_kube
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "kube" ]]; then    uv sync --package c7n_kube --frozen --inexact; fi

ADD tools/c7n_openstack /src/tools/c7n_openstack
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "openstack" ]]; then    uv sync --package c7n_openstack --frozen --inexact; fi

ADD tools/c7n_tencentcloud /src/tools/c7n_tencentcloud
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "tencentcloud" ]]; then    uv sync --package c7n_tencentcloud --frozen --inexact; fi

ADD tools/c7n_oci /src/tools/c7n_oci
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "oci" ]]; then    uv sync --package c7n_oci --frozen --inexact; fi

ADD tools/c7n_awscc /src/tools/c7n_awscc
RUN --mount=type=cache,target=/root/.cache/uv \
    if [[ " ${providers[*]} " =~ "awscc" ]]; then    uv sync --package c7n_awscc --frozen --inexact; fi


RUN mkdir /output

# Install c7n-kube
ADD tools/c7n_kube /src/tools/c7n_kube
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package c7n_kube

FROM ubuntu:24.04

LABEL name="kube" \
      repository="http://github.com/cloud-custodian/cloud-custodian"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get --yes update \
        && apt-get --yes install python3 python3-venv adduser  --no-install-recommends \
        && rm -Rf /var/cache/apt \
        && rm -Rf /var/lib/apt/lists/* \
        && rm -Rf /var/log/*

# These should remain below any other commands because they will invalidate
# the layer cache
COPY --from=build-env /src /src
COPY --from=build-env /usr/local /usr/local
COPY --from=build-env /output /output


RUN adduser --disabled-login --gecos "" custodian
RUN ln -s /src/.venv/bin/c7n-kube /usr/local/bin/c7n-kates
USER custodian
WORKDIR /home/custodian
ENV LC_ALL="C.UTF-8" LANG="C.UTF-8"
VOLUME ["/home/custodian"]
ENTRYPOINT ["/usr/local/bin/c7n-kates"]
CMD ["--help"]

LABEL "org.opencontainers.image.title"="kube"
LABEL "org.opencontainers.image.description"="Cloud Custodian Kubernetes Hooks"
LABEL "org.opencontainers.image.documentation"="https://cloudcustodian.io/docs"
